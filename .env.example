INFERENCE_MODE=api
INFERENCE_PROVIDER=modal

# URL printed by: modal deploy modal_app.py
MEDGEMMA_API_URL=
# Optional. Must match MEDGEMMA_API_KEY on the Modal side if you set one.
MEDGEMMA_API_KEY=

# Create this as a Modal secret (not needed on every laptop after deploy):
#   modal secret create huggingface HF_TOKEN=hf_...
HF_TOKEN=

# Fallbacks (not MedGemma):
# INFERENCE_PROVIDER=gemini
# GEMINI_API_KEY=
# INFERENCE_PROVIDER=openai
# OPENAI_API_KEY=

# Local GPU only:
# INFERENCE_MODE=local
